---
import AdminLayout from "../../layouts/AdminLayout.astro"
import {
  assignTwoFactorEntryToUsers,
  createDB,
  createLog,
  createTwoFactorEntry,
  deleteTwoFactorEntry,
  getAdminById,
  getTwoFactorEntry,
  getTwoFactorEntryUsersMap,
  listTwoFactorEntries,
  listUsers,
  updateTwoFactorEntry,
} from "database"
import { verifyToken } from "../../lib/auth"
import { parseTotpInput } from "../../lib/totp"
import { formatDate } from "../../lib/utils"
import { AdminTwoFactorTable } from "../../components/admin/AdminTwoFactorTable"
import QrImportPanel from "../../components/totp/QrImportPanel"
import { Card, CardContent, CardHeader, CardTitle } from "../../components/ui/card"
import { Button } from "../../components/ui/button"
import { Badge } from "../../components/ui/badge"
import { Plus, ShieldCheck } from "lucide-react"

const db = createDB(Astro.locals.runtime.env.DB)
const jwtSecret = Astro.locals.runtime.env.JWT_SECRET

const token = Astro.cookies.get("admin_token")?.value
if (!token) return Astro.redirect("/admin/login")
const payload = await verifyToken(token, jwtSecret)
if (!payload || payload.type !== "admin") return Astro.redirect("/admin/login")
const admin = await getAdminById(db, payload.id)
if (!admin) return Astro.redirect("/admin/login")

let message = ""
let messageType: "success" | "error" = "success"

function getOptionalText(formData: FormData, key: string): string | null {
  const value = formData.get(key)?.toString()?.trim()
  return value ? value : null
}

function isOtpAuthInput(input: string): boolean {
  return input.trim().toLowerCase().startsWith("otpauth://")
}

function isDefaultTotpConfig(entry: { digits: number; period: number; algorithm: string }): boolean {
  return entry.digits === 6 && entry.period === 30 && entry.algorithm === "SHA1"
}

function parseTwoFactorForm(
  formData: FormData,
  existingEntry?: {
    name: string
    issuer: string | null
    accountName: string | null
    digits: number
    period: number
    algorithm: string
  }
) {
  const secretInput = formData.get("secret_input")?.toString() || ""
  const note = getOptionalText(formData, "note")
  const keepExistingMetadata = Boolean(existingEntry) && !isOtpAuthInput(secretInput)

  const parsed = parseTotpInput(secretInput, {
    name: keepExistingMetadata ? existingEntry?.name : undefined,
    issuer: keepExistingMetadata ? existingEntry?.issuer : undefined,
    accountName: keepExistingMetadata ? existingEntry?.accountName : undefined,
    digits: keepExistingMetadata ? existingEntry?.digits : undefined,
    period: keepExistingMetadata ? existingEntry?.period : undefined,
    algorithm: keepExistingMetadata ? existingEntry?.algorithm : undefined,
    note,
  })

  if (parsed.name === "未命名 2FA" && note) {
    return { ...parsed, name: note }
  }

  return parsed
}

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData()
  const action = formData.get("action")?.toString()

  try {
    if (action === "create") {
      const parsed = parseTwoFactorForm(formData)

      const entry = await createTwoFactorEntry(db, {
        ...parsed,
        createdBy: admin.id,
      })
      await createLog(db, {
        adminId: admin.id,
        action: "create_two_factor_entry",
        target: entry.id,
        details: { name: parsed.name, issuer: parsed.issuer, accountName: parsed.accountName },
      })
      message = "2FA 条目创建成功"
    } else if (action === "edit") {
      const id = formData.get("id")?.toString()
      if (id) {
        const currentEntry = await getTwoFactorEntry(db, id, { includeSecret: true })
        if (!currentEntry) {
          throw new Error("2FA 条目不存在")
        }

        const parsed = parseTwoFactorForm(formData, currentEntry)
        await updateTwoFactorEntry(db, id, parsed)
        await createLog(db, {
          adminId: admin.id,
          action: "update_two_factor_entry",
          target: id,
          details: { name: parsed.name, issuer: parsed.issuer, accountName: parsed.accountName },
        })
        return Astro.redirect("/admin/two-factor?msg=updated")
      }
    } else if (action === "delete") {
      const id = formData.get("id")?.toString()
      if (id) {
        await deleteTwoFactorEntry(db, id)
        await createLog(db, {
          adminId: admin.id,
          action: "delete_two_factor_entry",
          target: id,
        })
        message = "2FA 条目已删除"
      }
    } else if (action === "assign_users") {
      const id = formData.get("id")?.toString()
      const userIds = formData.getAll("user_ids[]").map((userId) => userId.toString()).filter(Boolean)
      if (id) {
        await assignTwoFactorEntryToUsers(db, id, userIds)
        await createLog(db, {
          adminId: admin.id,
          action: "assign_two_factor_entry_users",
          target: id,
          details: { userIds },
        })
        message = "2FA 分配已更新"
      }
    }
  } catch (cause: any) {
    message = cause?.message || "操作失败"
    messageType = "error"
  }
}

if (Astro.url.searchParams.get("msg") === "updated") {
  message = "2FA 条目更新成功"
  messageType = "success"
}

const users = await listUsers(db, { limit: 200 })
const entries = await listTwoFactorEntries(db, { includeSecret: true })
const entryAssignments = Object.entries(
  await getTwoFactorEntryUsersMap(db, entries.map((entry) => entry.id))
)

const assignmentMap = Object.fromEntries(
  entryAssignments.map(([entryId, assignments]) => [
    entryId,
    assignments.map((assignment) => {
      const user = users.find((item) => item.id === assignment.userId)
      return {
        userId: assignment.userId,
        userName: user?.name || user?.note || `${user?.token.slice(0, 8) || assignment.userId}...`,
      }
    }),
  ])
)

const tableUsers = users.map((user) => ({
  id: user.id,
  name: user.name,
  note: user.note,
  token: user.token,
}))

const tableEntries = entries.map((entry) => ({
  id: entry.id,
  name: entry.name,
  issuer: entry.issuer,
  accountName: entry.accountName,
  secret: entry.secret || "",
  digits: entry.digits,
  period: entry.period,
  algorithm: entry.algorithm,
  note: entry.note,
  updatedAtLabel: formatDate(entry.updatedAt),
  assignedUsers: assignmentMap[entry.id] || [],
}))

const urlAction = Astro.url.searchParams.get("action")
const editId = Astro.url.searchParams.get("id")
const editEntry = urlAction === "edit" && editId ? await getTwoFactorEntry(db, editId, { includeSecret: true }) : null
const showCreateForm = urlAction === "create"
const showEditForm = urlAction === "edit" && !!editEntry
---

<AdminLayout title="2FA 管理">
  <div class="space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">2FA 管理</h1>
        <p class="mt-1 text-sm text-muted-foreground">
          只需要粘贴密钥、`otpauth://` 链接，或直接扫码，系统会自动识别服务名、账号和标准 TOTP 参数。
        </p>
      </div>
      <a href={(showCreateForm || showEditForm) ? "/admin/two-factor" : "/admin/two-factor?action=create"}>
        <Button>
          {(showCreateForm || showEditForm)
            ? "返回列表"
            : <><Plus className="mr-2 h-4 w-4" /> 新建 2FA</>}
        </Button>
      </a>
    </div>

    {message && (
      <div class={`rounded-md border p-4 ${messageType === "success" ? "border-green-200 bg-green-50 text-green-900" : "border-red-200 bg-red-50 text-red-900"}`}>
        {message}
      </div>
    )}

    {(showCreateForm || showEditForm) && (
      <Card>
        <CardHeader>
          <CardTitle>{showEditForm ? "编辑 2FA 条目" : "创建 2FA 条目"}</CardTitle>
        </CardHeader>
        <CardContent>
          <form method="POST" class="space-y-4">
            <input type="hidden" name="action" value={showEditForm ? "edit" : "create"} />
            {showEditForm && <input type="hidden" name="id" value={editEntry!.id} />}

            <div class="space-y-2">
              <label class="text-sm font-medium">2FA 密钥 / otpauth 链接</label>
              <textarea
                id="two-factor-secret-input"
                name="secret_input"
                required
                class="min-h-[110px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm outline-none focus:border-primary"
                placeholder="直接粘贴 Base32 密钥、otpauth://totp/... 链接，或使用下方二维码导入"
              >{editEntry?.secret || ""}</textarea>
              <p class="text-xs text-muted-foreground">
                直接输入纯密钥时会使用标准 TOTP 默认值；编辑已有条目且只替换密钥时，会自动沿用当前识别结果。
              </p>
            </div>

            <div>
              <QrImportPanel
                client:load
                secretInputId="two-factor-secret-input"
                autoSubmitCheckboxId="two-factor-auto-submit"
                submitButtonId="two-factor-submit-button"
              />
            </div>

            {showEditForm && (
              <div class="rounded-lg border bg-muted/30 px-4 py-3">
                <div class="text-sm font-medium">当前识别结果</div>
                <div class="mt-2 flex flex-wrap gap-2">
                  <Badge variant="outline">{editEntry!.name}</Badge>
                  {editEntry?.issuer && <Badge variant="secondary">{editEntry.issuer}</Badge>}
                  {editEntry?.accountName && <Badge variant="secondary" className="font-mono">{editEntry.accountName}</Badge>}
                  {!isDefaultTotpConfig(editEntry!) && (
                    <Badge variant="secondary">{editEntry!.algorithm} / {editEntry!.digits} 位 / {editEntry!.period}s</Badge>
                  )}
                </div>
              </div>
            )}

            <div class="flex items-center gap-2 rounded-md border bg-muted/30 px-3 py-2 text-sm">
              <input
                id="two-factor-auto-submit"
                type="checkbox"
                class="h-4 w-4 rounded border-gray-300"
              />
              <label for="two-factor-auto-submit" class="cursor-pointer select-none">
                扫码成功后自动{showEditForm ? "保存" : "创建"} 2FA
              </label>
            </div>

            <div class="space-y-2">
              <label class="text-sm font-medium">备注（可选）</label>
              <textarea
                name="note"
                class="min-h-[88px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm outline-none focus:border-primary"
                placeholder="例如：Gmail 主号、团队共享账号、备用设备等"
              >{editEntry?.note || ""}</textarea>
            </div>

            <div class="flex gap-2">
              <Button id="two-factor-submit-button" type="submit">
                <ShieldCheck className="mr-2 h-4 w-4" />
                {showEditForm ? "保存修改" : "创建条目"}
              </Button>
              <a href="/admin/two-factor">
                <Button type="button" variant="outline">取消</Button>
              </a>
            </div>
          </form>
        </CardContent>
      </Card>
    )}

    <Card>
      <AdminTwoFactorTable client:load entries={tableEntries} allUsers={tableUsers} />
    </Card>
  </div>
</AdminLayout>
