---
import { AdminSidebar } from "../components/AdminSidebar"

interface Props {
  title: string
}

const { title } = Astro.props
const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - XMail Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased relative overflow-x-hidden">
    <!-- Immersive Animated Ambient Background -->
    <div class="fixed inset-0 z-[-1] overflow-hidden bg-background">
      <div class="absolute top-[10%] -left-[10%] w-[50%] h-[50%] rounded-full bg-primary/15 mix-blend-multiply blur-[120px] animate-blob"></div>
      <div class="absolute bottom-[20%] -right-[20%] w-[60%] h-[60%] rounded-full bg-accent/20 mix-blend-multiply blur-[120px] animate-blob" style="animation-delay: 2s"></div>
      <!-- Subtle Grid Overlay -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
      <div class="absolute inset-0 bg-background/50 backdrop-blur-[80px] dark:backdrop-blur-[120px]"></div>
    </div>
    <div class="flex h-screen overflow-hidden bg-transparent">
      <!-- 桌面端悬浮布局 -->
      <div class="hidden md:flex flex-1 min-w-0 overflow-hidden p-6 gap-6 relative z-10">
        <div class="h-full rounded-[24px] overflow-hidden glass-panel flex-shrink-0 animate-fade-in-up z-20" style="animation-duration: 0.8s;">
          <AdminSidebar currentPath={currentPath} client:load />
        </div>
        <main class="flex-1 min-w-0 h-full overflow-y-auto overflow-x-hidden rounded-[24px] glass-panel relative animate-fade-in-up z-10" style="animation-duration: 0.8s; animation-delay: 0.1s; animation-fill-mode: both;">
          <div class="container py-8 px-6 lg:px-8 max-w-7xl mx-auto min-w-0">
            <slot />
          </div>
        </main>
      </div>

      <!-- 移动端弹性布局 -->
      <div class="md:hidden flex flex-col flex-1 min-w-0 h-screen relative z-10">
        <AdminSidebar currentPath={currentPath} client:load />
        <main class="flex-1 min-w-0 overflow-y-auto overflow-x-hidden pt-14">
          <div class="container py-4 px-4 mx-auto min-w-0 animate-fade-in-up">
            <slot />
          </div>
        </main>
      </div>
    </div>
    <script>
      let activeRowPointer = null

      const shouldIgnoreRowClick = (target) =>
        !!target.closest("a, button, input, textarea, select, label, summary, [role='button'], [data-row-ignore]")

      const hasSelectionInsideRow = (row) => {
        const selection = window.getSelection?.()
        if (!selection || selection.isCollapsed) {
          return false
        }

        return [selection.anchorNode, selection.focusNode].some((node) => node && row.contains(node))
      }

      const hasDraggedInsideRow = (row) => activeRowPointer?.row === row && activeRowPointer.dragged

      const openRowLink = (row, event) => {
        const href = row.dataset.rowLink
        if (!href) {
          return
        }

        if (event instanceof MouseEvent && (event.metaKey || event.ctrlKey || event.button === 1)) {
          window.open(href, "_blank", "noopener")
          return
        }

        window.location.assign(href)
      }

      document.addEventListener("pointerdown", (event) => {
        const target = event.target
        if (!(target instanceof Element)) {
          activeRowPointer = null
          return
        }

        const row = target.closest("[data-row-link]")
        if (!(row instanceof HTMLElement) || shouldIgnoreRowClick(target)) {
          activeRowPointer = null
          return
        }

        activeRowPointer = {
          row,
          pointerId: event.pointerId,
          startX: event.clientX,
          startY: event.clientY,
          dragged: false,
        }
      })

      document.addEventListener("pointermove", (event) => {
        if (!activeRowPointer || activeRowPointer.pointerId !== event.pointerId) {
          return
        }

        if (Math.abs(event.clientX - activeRowPointer.startX) > 4 || Math.abs(event.clientY - activeRowPointer.startY) > 4) {
          activeRowPointer.dragged = true
        }
      })

      document.addEventListener("pointerup", (event) => {
        if (!activeRowPointer || activeRowPointer.pointerId !== event.pointerId) {
          return
        }

        window.setTimeout(() => {
          activeRowPointer = null
        }, 0)
      })

      document.addEventListener("pointercancel", () => {
        activeRowPointer = null
      })

      document.addEventListener("click", (event) => {
        const target = event.target
        if (!(target instanceof Element)) {
          return
        }

        const row = target.closest("[data-row-link]")
        if (!(row instanceof HTMLElement) || shouldIgnoreRowClick(target) || hasSelectionInsideRow(row) || hasDraggedInsideRow(row)) {
          return
        }

        openRowLink(row, event)
      })

      document.addEventListener("auxclick", (event) => {
        if (event.button !== 1) {
          return
        }

        const target = event.target
        if (!(target instanceof Element)) {
          return
        }

        const row = target.closest("[data-row-link]")
        if (!(row instanceof HTMLElement) || shouldIgnoreRowClick(target) || hasSelectionInsideRow(row) || hasDraggedInsideRow(row)) {
          return
        }

        event.preventDefault()
        openRowLink(row, event)
      })

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") {
          return
        }

        const target = event.target
        if (!(target instanceof HTMLElement)) {
          return
        }

        const row = target.closest("[data-row-link]")
        if (!(row instanceof HTMLElement) || row !== target) {
          return
        }

        event.preventDefault()
        openRowLink(row, event)
      })
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/globals.css";
</style>
